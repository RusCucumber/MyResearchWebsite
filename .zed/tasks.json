[
    {
        "label": "Quarto: Preview Site",
        "command": "quarto",
        "args": ["preview"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["Quarto"],
    },
    {
        "label": "Quarto: Render Site",
        "command": "quarto",
        "args": ["render"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["Quarto"],
    },
    {
        "label": "Quarto: Preview Current File",
        "command": "quarto",
        "args": ["preview", "$ZED_FILE"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["Quarto"],
    },
]
