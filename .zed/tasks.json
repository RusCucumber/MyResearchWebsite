[
    {
        "label": "Jekyll: Preview Site (docker compose up)",
        "command": "docker",
        "args": ["compose", "up", "--build"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["Jekyll"],
    },
    {
        "label": "Jekyll: Stop Preview (docker compose down)",
        "command": "docker",
        "args": ["compose", "down"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "on_success",
        "tags": ["Jekyll"],
    },
]
