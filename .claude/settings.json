{
  "env": {
    "GIT_CONFIG_COUNT": "4",
    "GIT_CONFIG_KEY_0": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_0": "git@github.com:",
    "GIT_CONFIG_KEY_1": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_1": "ssh://git@github.com/",
    "GIT_CONFIG_KEY_2": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_2": "",
    "GIT_CONFIG_KEY_3": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_3": "!gh auth git-credential"
  },
  "permissions": {
    "allow": [
      "// Local git operations",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(git show)",
      "Bash(git branch)",
      "Bash(git checkout)",
      "Bash(git fetch)",
      "Bash(git pull)",
      "Bash(git push)",
      "Bash(git stash)",
      "Bash(git tag)",
      "Bash(git add)",
      "Bash(git commit)",
      "// Directory/file exploration (read-only)",
      "Bash(ls)",
      "Bash(find)",
      "Bash(pwd)",
      "Bash(tree)",
      "Bash(fd)",
      "// Safe text viewing",
      "Bash(grep)",
      "Bash(ripgrep)",
      "Bash(rg)",
      "Bash(wc)",
      "Bash(file)",
      "Bash(stat)",
      "// Skills pre-approval (reduces permission friction)",
      "Skill(git-strategy)"
    ],
    "deny": [
      "Read(.env)",
      "Read(*.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(**/.env.*)",
      "Read(.envrc)",
      "Read(**/.envrc)",
      "Read(secrets/**)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Edit(secrets/**)",
      "Edit(./*.pem)",
      "Edit(./*.key)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(~/.ssh/**)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(vim *.env*)",
      "Bash(nano *.env*)",
      "Bash(bat *.env*)",
      "Bash(open *.env*)",
      "Edit(.env*)",
      "Edit(**/.env*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(uname -s)\" = \"Darwin\" ] && command -v afplay >/dev/null 2>&1; then afplay /System/Library/Sounds/Glass.aiff; fi; exit 0"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "genshijin@genshijin": true,
    "oh-my-claudecode@omc": true,
    "claude-mem@thedotmack": true,
    "superpowers@anthropic-plugin-directory": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "api.anthropic.com",
        "api.github.com",
        "localhost",
        "127.0.0.1",
        "chatgpt.com",
        "*.chatgpt.com",
        "*.openai.com"
      ],
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.trustd.agent"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude/.omc",
        "~/.claude/plugins/oh-my-claudecode",
        "~/.claude/plugins/cache/omc",
        "~/.codex",
        "~/.claude-mem"
      ],
      "denyRead": [
        "**/.env*",
        "**/*.pem",
        "**/*.key",
        "secrets/**",
        "~/.ssh/**"
      ],
      "allowRead": [
        "~/.claude"
      ]
    }
  }
}
